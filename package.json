{
  "name": "Otaku-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./elektron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev\" \"npm run server\" \"npm run wait-electron\"",
    "server": "npx json-server --watch ./data/data.json",
    "electron": "electron .",
    "wait-electron": "wait-on tcp:5173 && npm run electron",
    "start": "concurrently \"npm run dev\" \"npm run server\" \"npm run wait-electron\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "apexcharts": "^5.15.2",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "i18next": "^26.3.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.6",
    "react-fast-marquee": "^1.6.5",
    "react-i18next": "^17.0.8",
    "react-loader-spinner": "^8.0.2",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.2",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.1",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.3.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "json-server": "^1.0.0-beta.15",
    "nodemon": "^3.1.14",
    "vite": "^8.0.12"
  }
}
